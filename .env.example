# ============================================================
# Dashboard Financeiro Pessoal — Variáveis de Ambiente
#
# Copie este arquivo para `.env` e ajuste os valores para o seu
# ambiente. Contém apenas chaves NÃO sensíveis (valores padrão).
# NUNCA commite o `.env` real no controle de versão.
# ============================================================

# Modo de execução: development | production | testing
FLASK_ENV=development

# Entrada da aplicação Flask (usada por `flask run` / gunicorn).
FLASK_APP=app.py

# Habilita o debugger do Flask (somente em desenvolvimento).
FLASK_DEBUG=1

# Chave secreta usada para assinar sessões/cookies do Flask.
# Gere uma forte com:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Caminho do banco de dados SQLite (relativo à raiz do projeto).
# Em produção via Docker use o caminho do volume: /app/data/financeiro.db
DATABASE_PATH=data/financeiro.db

# Alias opcional (formato SQLAlchemy "sqlite:///caminho" ou caminho puro).
# Se definido, tem precedência sobre DATABASE_PATH.
# DATABASE_URL=sqlite:///data/financeiro.db

# Pasta onde os holerites (PDFs) enviados serão armazenados.
UPLOAD_FOLDER=uploads

# Limite de usuários (multi-tenant) suportados pela instância.
MAX_USERS=10

# Chave da API DeepSeek (deixe vazio para desabilitar a integração de IA).
DEEPSEEK_API_KEY=

# URL base da API DeepSeek.
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Marca o cookie de sessão como Secure (use '1' apenas atrás de HTTPS/TLS).
SESSION_COOKIE_SECURE=0

# Número de workers do gunicorn (produção).
GUNICORN_WORKERS=2

